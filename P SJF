import java.util.*;

public class SJFPreemptive {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input: Number of processes
        System.out.print("Enter the number of processes: ");
        int n = sc.nextInt();

        int[] bt = new int[n];        // Burst Time
        int[] at = new int[n];        // Arrival Time
        int[] rt = new int[n];        // Remaining Time
        int[] wt = new int[n];        // Waiting Time
        int[] tat = new int[n];       // Turnaround Time
        int[] ct = new int[n];        // Completion Time
        boolean[] completed = new boolean[n]; // Process completion status

        // Input: Arrival Time and Burst Time for each process
        System.out.println("Enter Arrival Time and Burst Time of the processes:");
        for (int i = 0; i < n; i++) {
            System.out.print("P" + (i + 1) + ": ");
            at[i] = sc.nextInt();
            bt[i] = sc.nextInt();
            rt[i] = bt[i];
        }

        int currentTime = 0, completedProcesses = 0;
        StringBuilder ganttChart = new StringBuilder();
        List<Integer> timeLine = new ArrayList<>();
        int prevProcess = -1;

        // Simulation loop
        while (completedProcesses < n) {
            int shortest = -1;
            int minRT = Integer.MAX_VALUE;

            // Find the process with the smallest remaining time among those that have arrived
            for (int i = 0; i < n; i++) {
                if (!completed[i] && at[i] <= currentTime && rt[i] < minRT) {
                    minRT = rt[i];
                    shortest = i;
                }
            }

            if (shortest != -1) {
                // Process found → execute 1 unit of time
                rt[shortest]--;

                if (prevProcess != shortest) {
                    ganttChart.append("P").append(shortest + 1).append(" ");
                    timeLine.add(currentTime);
                    prevProcess = shortest;
                }

                currentTime++;

                // Process completes
                if (rt[shortest] == 0) {
                    completed[shortest] = true;
                    completedProcesses++;

                    ct[shortest] = currentTime;
                    tat[shortest] = ct[shortest] - at[shortest];
                    wt[shortest] = tat[shortest] - bt[shortest];
                }
            } else {
                // No process available → CPU idle
                if (prevProcess != -2) {
                    ganttChart.append("idle ");
                    timeLine.add(currentTime);
                    prevProcess = -2;
                }
                currentTime++;
            }
        }

        timeLine.add(currentTime);

        // Print Gantt Chart
        System.out.println("\nGantt Chart:");
        System.out.print(" ");
        for (int i = 0; i < ganttChart.toString().trim().split(" ").length; i++) {
            System.out.print("-------");
        }
        System.out.println();
        System.out.print("|");

        String[] chartLabels = ganttChart.toString().trim().split(" ");
        for (String label : chartLabels) {
            System.out.printf(" %-5s|", label);
        }
        System.out.println();

        System.out.print(" ");
        for (int i = 0; i < chartLabels.length; i++) {
            System.out.print("-------");
        }
        System.out.println();

        for (int t : timeLine) {
            System.out.printf("%-7d", t);
        }
        System.out.println("\n");

        // Process Table Output
        float avgWT = 0, avgTAT = 0;
        System.out.println("Process\tAT\tBT\tCT\tTAT\tWT");
        for (int i = 0; i < n; i++) {
            avgWT += wt[i];
            avgTAT += tat[i];
            System.out.println("P" + (i + 1) + "\t" + at[i] + "\t" + bt[i] + "\t" +
                    ct[i] + "\t" + tat[i] + "\t" + wt[i]);
        }

        System.out.printf("\nAverage Waiting Time: %.2f\n", avgWT / n);
        System.out.printf("Average Turnaround Time: %.2f\n", avgTAT / n);

        sc.close();
    }
}
